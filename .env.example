# Settings for `docker compose up` (docker-compose.yml). Copy to .env in this folder; .env is git-ignored.
# The MANAGIO_ prefix keeps these apart from anything else in your .env. Reference: docs/ENVIRONMENT.md.
# Values in REPLACE_WITH_... form must be replaced. Never commit real values.

# Required
MANAGIO_DB_PASSWORD=REPLACE_WITH_A_DATABASE_PASSWORD
# At least 32 random characters, e.g. `openssl rand -base64 48`.
MANAGIO_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Optional
# Shared by the API and the web app (docs/ARCHITECTURE.md, "Client address"); empty or at least 32 random characters,
# e.g. `openssl rand -hex 32`. Only matters when a reverse proxy in front sets MANAGIO_CLIENT_IP_HEADER.
MANAGIO_API_PROXY_SECRET=
MANAGIO_CLIENT_IP_HEADER=
# Port the web app is published on.
MANAGIO_WEB_PORT=3000
# Empty: emails are written to the API's log instead of sent.
MANAGIO_RESEND_API_KEY=
MANAGIO_MAIL_FROM=Managio <onboarding@resend.dev>
# true writes email bodies (with their single-use links) to the API log, so you can follow them locally.
MANAGIO_MAIL_LOG_CONTENT=false
# Google sign-in; used by both the API and the web app. Empty turns it off.
MANAGIO_GOOGLE_CLIENT_ID=
# Comma-separated emails of platform administrators (D-028).
MANAGIO_PLATFORM_ADMIN_EMAILS=
