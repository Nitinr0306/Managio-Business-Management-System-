# Where /api/* is passed through to (the Spring API). The browser never calls it directly.
API_ORIGIN=http://localhost:8081

# Google Identity Services client ID for "Continue with Google". Leave empty to hide the button.
# The same value as the API's GOOGLE_CLIENT_ID. Read at build time: rebuild or restart `npm run dev` after changing it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only, read at run time. The same value as the API's API_PROXY_SECRET; the /api pass-through uses it to
# vouch for the visitor's address. Never prefix it with NEXT_PUBLIC_.
API_PROXY_SECRET=
# Server-only. The request header holding the visitor's address, set by the proxy in front of this app. Not
# needed on Vercel (x-forwarded-for is used there). Self-hosted: only name a header your front proxy overwrites.
# CLIENT_IP_HEADER=x-real-ip

# End-to-end tests only: the API's log file, so tests can follow emailed links.
# E2E_API_LOG=C:\path\to\api.log
