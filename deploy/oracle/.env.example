# Compose settings on the VM. Copy to .env in /opt/managio, fill in, then chmod 600 .env. Never commit .env.
# The image tag to run (deploy.sh rewrites this line).
API_TAG=<image tag on Docker Hub>
# The API's public host name: api.managio.me (needs an A record) or <ip-with-dashes>.nip.io (no DNS change).
API_HOST=api.managio.me
# The database password, used by PostgreSQL and the API: openssl rand -hex 24
DB_PASSWORD=<random value>
