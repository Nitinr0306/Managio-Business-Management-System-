# The API's production settings on the VM (docs/DEPLOYMENT_RUNBOOK.md, section 3). Copy to api.env in
# /opt/managio, fill in the values there, then chmod 600 api.env. Never commit api.env or paste its values elsewhere.
# The database settings (DB_URL, DB_USERNAME, DB_PASSWORD) come from compose.yml and .env, not from this file.

# Random values made on your own machine: openssl rand -base64 48 and openssl rand -hex 32.
JWT_SECRET=<at least 32 random characters>
# The same value goes into the Vercel project's API_PROXY_SECRET.
API_PROXY_SECRET=<64 hex characters>

CORS_ALLOWED_ORIGINS=https://managio.me
APP_URL=https://managio.me

# Resend send-only key; without it emails are not sent.
RESEND_API_KEY=<resend send-only key>
MAIL_FROM=Managio <noreply@managio.me>

# Public by design; the same value as the web app's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=<google oauth client id>
# Optional: who may open the platform console.
PLATFORM_ADMIN_EMAILS=
