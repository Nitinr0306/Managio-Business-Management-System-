# Managio API settings. Copy to managio_backend/.env for local development (it is git-ignored and read on
# start-up); in production set these as environment variables on the host. Full reference: docs/ENVIRONMENT.md.
# Values in REPLACE_WITH_... form must be replaced. Never commit real values.

# ── Database (required) ──────────────────────────────────────────────────────
# Local development uses the PostgreSQL container on port 5433 (docs/TESTING.md, "Local database"); never point a
# development machine at the production database. On Render, use Neon's direct (non-pooled) host with
# ?sslmode=require, e.g. jdbc:postgresql://<host>/<database>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5433/managio
DB_USERNAME=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Connections in the pool; keep small on Neon and Render free tiers.
DB_POOL_SIZE=5

# ── Security (required) ──────────────────────────────────────────────────────
# Signs access tokens. At least 32 random characters, e.g. `openssl rand -base64 48`. Rotating it signs everyone out.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Secure cookies need HTTPS. Keep true everywhere except plain-http local development.
SECURE_COOKIES=true
# Browser origins allowed to call the API directly. The web app proxies /api, so this is its own URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Multiplies every rate limit. 1 in production; local development and end-to-end runs may raise it.
RATE_LIMIT_MULTIPLIER=1
# Shared with the web app (its API_PROXY_SECRET). Proves that the client address the web app reports is genuine,
# so rate limits count visitors, not the web server. At least 32 random characters, e.g. `openssl rand -hex 32`.
# Empty: every request counts against the connecting address (fine locally, wrong behind Vercel).
API_PROXY_SECRET=

# ── Web app links ────────────────────────────────────────────────────────────
# Where emailed links (verification, password reset, invitations) point.
APP_URL=http://localhost:3000

# ── Email through Resend (optional) ──────────────────────────────────────────
# Empty: emails are logged instead of sent. Production needs a key and a verified sender domain.
RESEND_API_KEY=
MAIL_FROM=Managio <onboarding@resend.dev>
# Log email bodies (they contain single-use links). Local development only.
MAIL_LOG_CONTENT=false

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Same client ID as the web app's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Empty turns Google sign-in off.
GOOGLE_CLIENT_ID=

# ── Platform console (optional) ──────────────────────────────────────────────
# Comma-separated emails of Managio's administrators (D-028). Their accounts must verify their email.
PLATFORM_ADMIN_EMAILS=

# ── Server ───────────────────────────────────────────────────────────────────
# 8081 locally, because Jenkins uses 8080 on the development machine. Render sets PORT itself; leave it unset there.
PORT=8081
# Publish /v3/api-docs and Swagger UI. Off in production; on locally for the frontend's type generation.
API_DOCS_ENABLED=false
# Set to debug to log SQL statements.
SQL_LOG_LEVEL=warn
